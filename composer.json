{
  "name": "maxbeckers/php-openapi-tools",
  "description": "Tools for transforming OpenAPI documents",
  "type": "library",
  "license": "MIT",
  "minimum-stability": "stable",
  "authors": [
    {
      "name": "Max Beckers",
      "email": "beckers.maximilian@gmail.com"
    }
  ],
  "require": {
    "php": ">=8.2",
    "guzzlehttp/psr7": "^2.13.6",
    "maxbeckers/php-yaml-parser": "^1.0.4",
    "softcreatr/jsonpath": "^2.2.1",
    "symfony/console": "^7.0|^8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "friendsofphp/php-cs-fixer": "^3.89"
  },
  "autoload": {
    "psr-4": {
      "MaxBeckers\\OpenApiTools\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MaxBeckers\\OpenApiTools\\Tests\\": "tests/"
    }
  },
  "bin": ["bin/openapi-tools"],
  "scripts": {
    "test": "@php -d xdebug.mode=off vendor/bin/phpunit",
    "cs": "php-cs-fixer fix --config=.php_cs.php -v --allow-risky=yes",
    "cs-check": "@cs --dry-run --diff"
  }
}
